<table cellpadding="0" cellspacing="0" border="0" role="presentation" style="font-family: Arial, Helvetica, sans-serif; max-width: 560px; width: 100%; background-color: #ffffff;">
  <tr>
    <td style="padding: 20px 24px; background-color: #f6f8fc; font-size: 18px; font-weight: bold; color: #334155;">
      {{.Title}}
    </td>
  </tr>
  <tr>
    <td style="padding: 20px 24px; font-size: 14px; line-height: 1.5; color: #334155;">
      <p style="margin: 0 0 16px 0;">{{.Message}}</p>
      <a href="{{.CTAURL}}" style="display: inline-block; padding: 10px 20px; background-color: #2e63e8; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 14px;">{{.CTALabel}}</a>
    </td>
  </tr>
  <tr>
    <td style="padding: 12px 24px; font-size: 11px; color: #334155; text-align: center;">
      No responder a este mensaje. Correo generado automáticamente.
    </td>
  </tr>
</table>
