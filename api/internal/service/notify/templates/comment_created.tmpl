<table cellpadding="0" cellspacing="0" border="0" role="presentation" style="font-family: Arial, Helvetica, sans-serif; max-width: 560px; width: 100%;">
  <tr>
    <td style="padding: 24px;">
      <p style="margin: 0 0 12px 0; font-size: 14px; line-height: 1.5; color: #1f2937;">
        Recibiste un mensaje de <strong>{{.AuthorName}}</strong>, en <strong>{{.GoalTitle}}</strong>.
      </p>
      <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #1f2937;">
        Ir a la meta -&gt; <a href="{{.GoalURL}}" style="color: #2563eb; text-decoration: none;">{{.GoalURL}}</a>
      </p>
    </td>
  </tr>
  <tr>
    <td style="padding: 12px 24px; font-size: 11px; color: #6b7280; text-align: center;">
      No responder a este mensaje. Correo generado automáticamente.
    </td>
  </tr>
</table>
