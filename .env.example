# BD configuration
POSTGRES_USER=sed
POSTGRES_PASSWORD=sed
POSTGRES_DB=sed

# Backend configuration
DATABASE_URL=postgres://sed:sed@localhost:5432/sed?sslmode=disable
IMPORT_DATABASE_URL=postgres://sed:sed@localhost:5432/sed?sslmode=disable
API_PORT=8080
CORS_ORIGINS=http://localhost:5173

# SSO / Keycloak (OIDC)
SSO_KC_ISSUER=http://sso.mobo.com.mx/auth/realms/mobo
SSO_CLIENT_ID=sed-evaluacion
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8088/api/v1/auth/sso-callback
SSO_POST_LOGOUT_URI=http://localhost:8088/api/v1/auth/logout-complete

# Admin revoke — API key for POST /auth/admin/revoke-employee/{empId}
# If empty/unset, the endpoint returns 403 forbidden.
ADMIN_REVOKE_KEY=

# Seed import
SEED_DB_URL=user:pass@tcp(host:3306)/mobonet?parseTime=true

# SSO seed (post-import) — crea usuarios en el portal SSO
SSO_SEED_BASE_URL=
SSO_SEED_ADMIN_USER=
SSO_SEED_ADMIN_PASSWORD=
SSO_SEED_DEV_EMPLOYEE_NUMBER=
