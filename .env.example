DATABASE_URL=postgres://sed:sed@localhost:5432/sed?sslmode=disable
API_PORT=8080
CORS_ORIGINS=http://localhost:5173
SEED_ON_START=true

# SSO / Keycloak (OIDC)
SSO_KC_ISSUER=http://auth.sso.mobo.com.mx/realms/mobo
SSO_CLIENT_ID=sed-evaluacion
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://localhost:8088/api/v1/auth/sso-callback
SSO_POST_LOGOUT_URI=https://localhost:8088/api/v1/auth/logout-complete

# Admin revoke — API key for POST /auth/admin/revoke-employee/{empId}
# If empty/unset, the endpoint returns 403 forbidden.
# TODO(auth:admin): when role-based UI exists, also accept session auth with PermAdminAll.
ADMIN_REVOKE_KEY=
