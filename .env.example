DATABASE_URL=postgres://sed:sed@localhost:5432/sed?sslmode=disable
API_PORT=8080
CORS_ORIGINS=http://localhost:5173
SEED_ON_START=true

# SSO / Keycloak (OIDC)
SSO_KC_ISSUER=http://auth.sso.mobo.com.mx/realms/mobo
SSO_CLIENT_ID=sed-evaluacion
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://localhost:8088/api/v1/auth/sso-callback
SSO_POST_LOGOUT_URI=https://localhost:8088/api/v1/auth/logout-complete

# Admin revoke — API key for POST /auth/admin/revoke-employee/{empId}
# If empty/unset, the endpoint returns 403 forbidden.
# TODO(auth:admin): when role-based UI exists, also accept session auth with PermAdminAll.
ADMIN_REVOKE_KEY=

# SSO seed (post-import) — crea usuarios en el portal SSO
# Credenciales del admin SSO. Base URL se deriva de SSO_KC_ISSUER (strip /realms/<realm>).
# Si la derivación falla o el seed API vive en otro path, usa SSO_SEED_BASE_URL explícita.
# Si están vacíos, el paso de seed SSO se omite sin error.
SSO_SEED_BASE_URL=
SSO_SEED_ADMIN_USER=
SSO_SEED_ADMIN_PASSWORD=
# Núm. de empleado a omitir del seeder (ej. el dev para no afectar su sesión).
SEED_SSO_DEV_EMPLOYEE_NUMBER=
